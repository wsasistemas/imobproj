# Mesmo Supabase do portal IMOBPROJ (valores públicos: vão dentro do app).
# Local: rode `npx supabase status` na raiz do IMOBPROJ. No celular use o IP da máquina, não 127.0.0.1.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.0.10:56321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<COLOQUE_A_CHAVE_ANON_AQUI>
# Portal web: o link "Esqueci a senha" leva para <portal>/redefinir-senha
EXPO_PUBLIC_PORTAL_URL=http://192.168.0.10:3000
