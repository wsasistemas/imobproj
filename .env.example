# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Local (supabase start): os valores aparecem no terminal / em `npx supabase status`.
# Nuvem: Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<COLOQUE_A_CHAVE_ANON_AQUI>
# Só no servidor (Server Actions / jobs). Nunca use com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<COLOQUE_A_CHAVE_SERVICE_ROLE_AQUI>

# E-mail transacional (opcional: "Solicitar ciência" das atas). Sem isto, a solicitação fica registrada como sem_provedor.
RESEND_API_KEY=<COLOQUE_A_CHAVE_AQUI>
EMAIL_REMETENTE=IMOBPROJ <nao-responda@seudominio.com.br>
# URL pública do portal (links em e-mails e mensagens do WhatsApp). Sem isto, usa o host da requisição.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
